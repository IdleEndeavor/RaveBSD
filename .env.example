# Copy this file to .env and change what you need. Every line is optional.

# Port on this machine where RaveBSD is reachable. Change it if 8080 is already used by something else.
PORT=8080

# Must match `id -u` and `id -g` of the user who owns the ./data folder.
PUID=1000
PGID=1000

# "browser" (default) sends a normal browser User-Agent, "rave" sends an honest RaveBSD one.
# Many sources refuse the honest one. Can also be changed on the Backend page.
USER_AGENT_MODE=

# If set, the JSON API (/api/v1/search) requires this value in an X-API-Key header.
API_KEY=

# Z-Library and Mobilism logins. Both can also be set on the Backend page.
# Z-Library works without a login. Mobilism needs a (free) account.
ZLIB_EMAIL=
ZLIB_PASSWORD=
ZLIB_DOMAIN=
MOBILISM_USER=
MOBILISM_PASS=
